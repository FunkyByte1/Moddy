{
  "name": "moddy",
  "version": "2026.6.15",
  "description": "One-click mod installation and management for supported games on Steam Deck.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FunkyByte1/Moddy.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "mods",
    "modding",
    "steam-deck",
    "melonloader"
  ],
  "author": "FunkyByte1",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/FunkyByte1/Moddy/issues"
  },
  "homepage": "https://github.com/FunkyByte1/Moddy#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "happy-dom": "^20.10.6",
    "react": "18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.9",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}